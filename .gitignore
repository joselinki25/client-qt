# Carpetas de compilación (Shadow builds de Qt Creator)
build-*/
build/
debug/
release/

# Archivos de configuración de usuario de Qt Creator
*.pro.user
*.pro.user.*

# Archivos generados automáticamente por Qt (MOC, UIC, RCC)
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
qrc_*.obj

# Archivos de compilación (Makefiles y objetos)
Makefile
Makefile.Debug
Makefile.Release
*.o
*.obj
object_script.*.Debug
object_script.*.Release
*.stash
*.cache

# Archivos ejecutables y librerías
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.app/

# Archivos ocultos del sistema operativo
.DS_Store
Thumbs.db